import Quickshell
import QtQuick
import Quickshell.Io

// 100% Rust background: bin/ttfx-bg-rs/target/release/ttfx-bg-rs
// Creates a gtk4-layer-shell bottom layer embedding `ttfx matrix` (Vte4),
// fed by a Rust PulseAudio + FFT analyzer. No Python, no LD_PRELOAD.
Item {
    property string pluginDir: Qt.resolvedUrl(".").toString().replace("file://", "")
    property string bin: pluginDir + "/bin/ttfx-bg-rs/target/release/ttfx-bg-rs"
    property bool running: true

    Process {
        id: bgProc
        running: parent.running
        command: [parent.bin]
        // inherits the Wayland/Hyprland environment from Quickshell
    }

    Component.onDestruction: bgProc.running = false
}
